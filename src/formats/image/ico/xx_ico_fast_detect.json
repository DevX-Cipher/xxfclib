{
  "schema": 1,
  "formats": [
    {
      "enum": "ICO",
      "sources": [
        "src/formats/image/ico/xx_ico.c",
        "src/formats/image/ico/xx_ico_extractor.c",
        "Binary/image_ICO.1.sg"
      ],
      "note": "Icon type 1 and cursor type 2 share directory and image payload layouts. Require nonzero count and first directory-entry reserved byte zero; the native reader validates payloads and cursor hotspots.",
      "rules": [
        {
          "tests": [
            {
              "origin": "base",
              "offset": 0,
              "hex": "00 00 01 00"
            },
            {
              "origin": "base",
              "offset": 4,
              "hex": "00 00",
              "not": true
            },
            {
              "origin": "base",
              "offset": 9,
              "hex": "00"
            }
          ],
          "min_size": 22
        },
        {
          "tests": [
            {
              "origin": "base",
              "offset": 0,
              "hex": "00 00 02 00"
            },
            {
              "origin": "base",
              "offset": 4,
              "hex": "00 00",
              "not": true
            },
            {
              "origin": "base",
              "offset": 9,
              "hex": "00"
            }
          ],
          "min_size": 22
        }
      ]
    }
  ]
}
