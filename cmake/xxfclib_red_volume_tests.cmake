option(XXFC_BUILD_RED_VOLUME_TESTS "Build RED fragment-pair tests" OFF)
if(XXFC_BUILD_RED_VOLUME_TESTS AND NOT TARGET test_red_volumes)
    enable_testing()
    add_executable(test_red_volumes "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_red_volumes.c")
    target_link_libraries(test_red_volumes PRIVATE xxfclib::xxfclib)
    add_test(NAME xxfc_red_volumes COMMAND test_red_volumes "${CMAKE_CURRENT_BINARY_DIR}/red-volumes")
endif()
