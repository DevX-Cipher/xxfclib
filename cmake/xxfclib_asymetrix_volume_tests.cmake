option(XXFC_BUILD_ASYMETRIX_VOLUME_TESTS "Build Asymetrix continuation-volume tests" OFF)
if(XXFC_BUILD_ASYMETRIX_VOLUME_TESTS AND NOT TARGET test_asymetrix_volumes)
    enable_testing()
    add_executable(test_asymetrix_volumes "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_asymetrix_volumes.c")
    target_link_libraries(test_asymetrix_volumes PRIVATE xxfclib::xxfclib)
    add_test(NAME xxfc_asymetrix_volumes COMMAND test_asymetrix_volumes "${CMAKE_CURRENT_BINARY_DIR}/asymetrix-volume-fixtures")
endif()
