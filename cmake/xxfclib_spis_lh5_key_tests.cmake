option(XXFC_BUILD_SPIS_LH5_KEY_TESTS "Build tiny SPIS LH5 caller-key recovery regressions" OFF)
if(XXFC_BUILD_SPIS_LH5_KEY_TESTS)
    if(NOT TARGET test_spis_lh5_key)
        # The exact LH5 decoder is private and intentionally stays unexported.
        set(_xxfc_spis_lh5_key_library "")
        if(TARGET xxfclib::xxfclib_static)
            set(_xxfc_spis_lh5_key_library xxfclib::xxfclib_static)
        elseif(NOT BUILD_SHARED_LIBS)
            set(_xxfc_spis_lh5_key_library xxfclib::xxfclib)
        else()
            message(STATUS "Skipping xxfc_spis_lh5_key: the private exact LH5 API requires static xxfclib")
        endif()
        if(_xxfc_spis_lh5_key_library)
            enable_testing()
            add_executable(test_spis_lh5_key "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_spis_lh5_key.c")
            target_link_libraries(test_spis_lh5_key PRIVATE ${_xxfc_spis_lh5_key_library})
            add_test(NAME xxfc_spis_lh5_key COMMAND test_spis_lh5_key "${CMAKE_CURRENT_BINARY_DIR}/spis-lh5-key-output")
        endif()
        unset(_xxfc_spis_lh5_key_library)
    endif()
endif()
