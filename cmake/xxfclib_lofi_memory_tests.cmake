option(XXFC_BUILD_LOFI_MEMORY_TESTS "Build LOFI working-buffer budget tests" OFF)
if(XXFC_BUILD_LOFI_MEMORY_TESTS)
    enable_testing()
    add_executable(test_lofi_memory "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_lofi_memory.c")
    target_link_libraries(test_lofi_memory PRIVATE xxfclib::xxfclib)
    add_test(NAME xxfc_lofi_memory COMMAND test_lofi_memory "${CMAKE_CURRENT_BINARY_DIR}/lofi-memory-output")
    add_executable(test_iso_output_names "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_iso_output_names.c")
    target_link_libraries(test_iso_output_names PRIVATE xxfclib::xxfclib)
    add_test(NAME xxfc_iso_output_names COMMAND test_iso_output_names "${CMAKE_CURRENT_BINARY_DIR}/iso-output-names")
endif()
