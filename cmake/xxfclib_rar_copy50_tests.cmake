option(XXFC_BUILD_RAR_COPY50_TESTS "Build optimized RAR5 overlapping LZ copy tests" OFF)
if(XXFC_BUILD_RAR_COPY50_TESTS)
    enable_testing()
    add_executable(test_rar_copy50 "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_rar_copy50.c")
    target_link_libraries(test_rar_copy50 PRIVATE xxfclib::xxfclib)
    if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(test_rar_copy50 PRIVATE -O2)
    elseif(MSVC)
        target_compile_options(test_rar_copy50 PRIVATE /O2)
    endif()
    add_test(NAME xxfc_rar_copy50 COMMAND test_rar_copy50)
endif()
