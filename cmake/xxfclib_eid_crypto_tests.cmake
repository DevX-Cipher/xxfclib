option(XXFC_BUILD_EID_CRYPTO_TESTS "Build EID Rijndael and RIPEMD-256 regression tests" OFF)
if(XXFC_BUILD_EID_CRYPTO_TESTS)
    enable_testing()
    add_executable(test_eid_crypto "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_eid_crypto.c")
    target_link_libraries(test_eid_crypto PRIVATE xxfclib::xxfclib)
    add_test(NAME xxfc_eid_crypto COMMAND test_eid_crypto)
    set(XXFC_EID_CRYPTO_SAMPLE "" CACHE FILEPATH "Optional stopped LicPers.eid sample for crypto integration testing")
    if(XXFC_EID_CRYPTO_SAMPLE)
        add_test(NAME xxfc_eid_crypto_sample COMMAND test_eid_crypto "${XXFC_EID_CRYPTO_SAMPLE}")
    endif()
endif()
