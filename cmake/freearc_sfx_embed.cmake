if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "FreeArc SFX embedding requires INPUT and OUTPUT")
endif()
file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _length)
math(EXPR _size "${_length} / 2")
if(_size LESS 1024 OR _size GREATER 16777216)
    message(FATAL_ERROR "Unexpected FreeArc SFX image size")
endif()
string(SUBSTRING "${_hex}" 0 4 _magic)
if(NOT _magic STREQUAL "4d5a")
    message(FATAL_ERROR "FreeArc SFX image is not a Windows executable")
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1,\n" _bytes "${_hex}")
get_filename_component(_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_directory}")
file(WRITE "${OUTPUT}" "/* Generated from the source-built XFU extraction-only FreeArc SFX. */\n#include <stddef.h>\nconst unsigned char xfu_freearc_sfx_data[] = {\n${_bytes}};\nconst size_t xfu_freearc_sfx_size = ${_size};\n")
