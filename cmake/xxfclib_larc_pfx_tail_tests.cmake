option(XXFC_BUILD_LARC_PFX_TAIL_TESTS "Build scoped LArc PFX terminal framing regressions" OFF)
if(XXFC_BUILD_LARC_PFX_TAIL_TESTS)
    enable_testing()
    if(NOT TARGET test_larc_pfx_tail)
        add_executable(test_larc_pfx_tail "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_larc_pfx_tail.c")
        target_link_libraries(test_larc_pfx_tail PRIVATE xxfclib::xxfclib)
        add_test(NAME xxfc_larc_pfx_tail COMMAND test_larc_pfx_tail "${CMAKE_CURRENT_BINARY_DIR}/larc-pfx-tail-output")
    endif()
    if(NOT TARGET test_pfx_prefix_native)
        add_executable(test_pfx_prefix_native "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_pfx_prefix_native.c")
        target_link_libraries(test_pfx_prefix_native PRIVATE xxfclib::xxfclib)
        add_test(NAME xxfc_pfx_prefix_native COMMAND test_pfx_prefix_native)
    endif()
endif()
