option(XXFC_BUILD_SQUASHFS_NOEOS_TESTS "Build legacy SquashFS LZMA range-flush tests" OFF)
if(XXFC_BUILD_SQUASHFS_NOEOS_TESTS AND NOT TARGET test_squashfs_noeos_lzma)
